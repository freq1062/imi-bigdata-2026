    "axes[0].hist(test_probs_calibrated, bins=50, alpha=0.5, label='After', edgecolor='black')\n",
    "axes[0].set(xlabel='Predicted Probability', ylabel='Count', title='Prediction Distribution')\n",
    "axes[0].legend()\n",
