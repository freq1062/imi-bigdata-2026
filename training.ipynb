        "    pyg_link = \"https://data.pyg.org/whl/torch-2.5.0+cu121.html\"\n",
        "    pyg_packages = [\"torch-scatter\", \"torch-sparse\", \"torch-cluster\", \"torch-spline-conv\"]\n",
