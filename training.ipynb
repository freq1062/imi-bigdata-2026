        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('model_evaluation.png', dpi=150, bbox_inches='tight')\n",
        "print(\"\\n✓ Evaluation plots saved to model_evaluation.png\")\n",
        "plt.show()\n"
